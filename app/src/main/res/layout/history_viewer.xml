<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumora_app_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/ic_lumora_back"
            android:drawablePadding="6dp"
            android:text="History"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView android:id="@+id/downloadButton" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_common_icon_circle" android:clickable="true" android:focusable="true" android:padding="9dp" android:src="@drawable/ic_lumora_download" android:tint="@color/lumora_lime" />
        <ImageView android:id="@+id/shareButton" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:background="@drawable/bg_common_icon_circle" android:clickable="true" android:focusable="true" android:padding="9dp" android:src="@drawable/ic_lumora_share" android:tint="@color/lumora_lime" />
        <ImageView android:id="@+id/feedbackButton" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:background="@drawable/bg_common_icon_circle" android:clickable="true" android:focusable="true" android:padding="9dp" android:src="@drawable/ic_lumora_info" android:tint="#FFCFBDFF" />
        <ImageView android:id="@+id/deleteButton" android:layout_width="38dp" android:layout_height="38dp" android:layout_marginStart="6dp" android:background="@drawable/bg_common_icon_circle" android:clickable="true" android:focusable="true" android:padding="9dp" android:src="@drawable/ic_lumora_delete" android:tint="#FFFF7A7A" />
    </LinearLayout>

    <TextView
        android:id="@+id/mediaTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/mediaFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_history_tile">

        <ImageView
            android:id="@+id/mediaImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/mediaVideo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:resize_mode="fit"
            app:show_buffering="when_playing"
            app:use_controller="false" />

        <TextView
            android:id="@+id/missingText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="16dp"
            android:text="Saved media file is missing."
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/imageControls"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_common_chip"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/zoomOutButton"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/ui_zoom_out"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_lumora_zoom_out"
                android:tint="@color/white" />

            <ImageButton
                android:id="@+id/zoomInButton"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/ui_zoom_in"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_lumora_zoom_in"
                android:tint="@color/white" />

            <ImageButton
                android:id="@+id/rotateLeftButton"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/ui_rotate"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_lumora_rotate_left"
                android:tint="@color/lumora_lime" />

            <ImageButton
                android:id="@+id/rotateRightButton"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/ui_rotate"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_lumora_rotate_right"
                android:tint="@color/lumora_lime" />

            <ImageButton
                android:id="@+id/resetImageButton"
                android:layout_width="42dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/ui_reset"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_lumora_reset"
                android:tint="#FFCFBDFF" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/videoControls"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_common_chip"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/playPauseButton"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/ui_play"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_lumora_pause"
                android:tint="@color/white" />

            <ImageButton
                android:id="@+id/muteButton"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/ui_mute"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_lumora_volume_on"
                android:tint="@color/lumora_lime" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/createdAt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FF94A0B8"
        android:textSize="11sp" />
</LinearLayout>
