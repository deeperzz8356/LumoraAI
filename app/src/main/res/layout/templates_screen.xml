<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumora_app_background">

    <LinearLayout
        android:id="@+id/loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/lumora_lime" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="Loading templates..."
            android:textColor="#FFB4BDD0"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/messageState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="32dp"
        android:textColor="#FF94A0B8"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/template_horizontal_padding"
        android:paddingTop="18dp"
        android:paddingEnd="@dimen/template_horizontal_padding">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/ui_templates"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/creditsChip"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_common_chip"
                android:clickable="true"
                android:drawableStart="@drawable/ic_lumora_star"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="90dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/lumora_lime"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/notificationButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_common_chip"
                android:clickable="true"
                android:contentDescription="@string/ui_notifications"
                android:focusable="true">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_lumora_bell"
                    android:tint="@color/white" />

                <View
                    android:id="@+id/unreadDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="7dp"
                    android:background="@drawable/bg_indicator_active"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fillViewport="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/imagesTab"
                    style="@style/TemplateCategoryTab"
                    android:text="@string/ui_template_images" />

                <TextView
                    android:id="@+id/videoTab"
                    style="@style/TemplateCategoryTab"
                    android:layout_marginStart="8dp"
                    android:text="@string/ui_template_video" />

                <TextView
                    android:id="@+id/promoVideoTab"
                    style="@style/TemplateCategoryTab"
                    android:layout_marginStart="8dp"
                    android:text="@string/ui_template_promo_video" />

                <TextView
                    android:id="@+id/avatarTab"
                    style="@style/TemplateCategoryTab"
                    android:layout_marginStart="8dp"
                    android:text="@string/ui_template_avatar" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/uploadTemplateImage"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_generation_upload"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/ui_upload_image"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sectionsList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="16dp"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
