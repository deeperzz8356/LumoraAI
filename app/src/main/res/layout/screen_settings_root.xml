<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsPageRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lumora_app_background"
    android:orientation="vertical">

    <!-- ── Header bar ─────────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@drawable/bg_generation_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_common_icon_circle"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_lumora_back"
            android:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Settings"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:text="Account, language, and plan controls"
                android:textColor="#FF95A0B7"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ── Scrollable content ─────────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- ── ACCOUNT ───────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Account"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Manage Profile row (individual card via style) -->
            <LinearLayout
                android:id="@+id/manageProfileRow"
                style="@style/LumoraSettingsRow">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_common_lime_circle_soft"
                    android:padding="10dp"
                    android:src="@drawable/ic_lumora_avatar"
                    android:tint="@color/lumora_lime" />

                <LinearLayout
                    style="@style/LumoraSettingsTextColumn"
                    android:layout_marginStart="14dp">

                    <TextView
                        style="@style/LumoraSettingsRowTitle"
                        android:text="Manage Profile" />

                    <TextView
                        style="@style/LumoraSettingsRowSubtitle"
                        android:text="Update your name and account details" />
                </LinearLayout>

                <FrameLayout style="@style/LumoraSettingsArrowButton">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="15dp"
                        android:src="@drawable/ic_lumora_arrow_right"
                        android:tint="@color/lumora_lime" />
                </FrameLayout>
            </LinearLayout>

            <!-- Subscription & Billing row -->
            <LinearLayout
                android:id="@+id/subscriptionRow"
                style="@style/LumoraSettingsRow">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_common_lime_circle_soft"
                    android:padding="10dp"
                    android:src="@drawable/ic_lumora_star"
                    android:tint="@color/lumora_lime" />

                <LinearLayout
                    style="@style/LumoraSettingsTextColumn"
                    android:layout_marginStart="14dp">

                    <TextView
                        style="@style/LumoraSettingsRowTitle"
                        android:text="Subscription &amp; Billing" />

                    <TextView
                        style="@style/LumoraSettingsRowSubtitle"
                        android:text="Plans, purchases, and credit packs" />
                </LinearLayout>

                <FrameLayout style="@style/LumoraSettingsArrowButton">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="15dp"
                        android:src="@drawable/ic_lumora_arrow_right"
                        android:tint="@color/lumora_lime" />
                </FrameLayout>
            </LinearLayout>

            <!-- ── PREFERENCES ────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:includeFontPadding="false"
                android:text="Preferences"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Language row -->
            <LinearLayout
                android:id="@+id/languageRow"
                style="@style/LumoraSettingsRow">

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_common_lime_circle_soft">

                    <androidx.compose.ui.platform.ComposeView
                        android:id="@+id/languageIconHost"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="9dp" />
                </FrameLayout>

                <LinearLayout
                    style="@style/LumoraSettingsTextColumn"
                    android:layout_marginStart="14dp">

                    <TextView
                        style="@style/LumoraSettingsRowTitle"
                        android:text="Language" />

                    <TextView
                        android:id="@+id/languageSubtitle"
                        style="@style/LumoraSettingsRowSubtitle"
                        android:text="English" />
                </LinearLayout>

                <FrameLayout style="@style/LumoraSettingsArrowButton">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="15dp"
                        android:src="@drawable/ic_lumora_arrow_right"
                        android:tint="@color/lumora_lime" />
                </FrameLayout>
            </LinearLayout>

            <!-- ── LEGAL ──────────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:includeFontPadding="false"
                android:text="Legal"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Privacy Policy row -->
            <LinearLayout
                android:id="@+id/privacyPolicyRow"
                style="@style/LumoraSettingsRow">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_common_lime_circle_soft"
                    android:padding="10dp"
                    android:src="@drawable/ic_lumora_settings"
                    android:tint="@color/lumora_lime" />

                <LinearLayout
                    style="@style/LumoraSettingsTextColumn"
                    android:layout_marginStart="14dp">

                    <TextView
                        style="@style/LumoraSettingsRowTitle"
                        android:text="Privacy Policy" />

                    <TextView
                        style="@style/LumoraSettingsRowSubtitle"
                        android:text="Read how Lumora handles your data" />
                </LinearLayout>

                <FrameLayout style="@style/LumoraSettingsArrowButton">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="15dp"
                        android:src="@drawable/ic_lumora_arrow_right"
                        android:tint="@color/lumora_lime" />
                </FrameLayout>
            </LinearLayout>

            <!-- Terms & Conditions row -->
            <LinearLayout
                android:id="@+id/termsRow"
                style="@style/LumoraSettingsRow">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_common_lime_circle_soft"
                    android:padding="10dp"
                    android:src="@drawable/ic_lumora_settings"
                    android:tint="@color/lumora_lime" />

                <LinearLayout
                    style="@style/LumoraSettingsTextColumn"
                    android:layout_marginStart="14dp">

                    <TextView
                        style="@style/LumoraSettingsRowTitle"
                        android:text="Terms &amp; Conditions" />

                    <TextView
                        style="@style/LumoraSettingsRowSubtitle"
                        android:text="Our terms of use and service agreement" />
                </LinearLayout>

                <FrameLayout style="@style/LumoraSettingsArrowButton">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="15dp"
                        android:src="@drawable/ic_lumora_arrow_right"
                        android:tint="@color/lumora_lime" />
                </FrameLayout>
            </LinearLayout>

            <!-- Share App row -->
            <LinearLayout
                android:id="@+id/shareAppRow"
                style="@style/LumoraSettingsRow">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_common_lime_circle_soft"
                    android:padding="10dp"
                    android:src="@drawable/ic_lumora_settings"
                    android:tint="@color/lumora_lime" />

                <LinearLayout
                    style="@style/LumoraSettingsTextColumn"
                    android:layout_marginStart="14dp">

                    <TextView
                        style="@style/LumoraSettingsRowTitle"
                        android:text="Share LumoraAI" />

                    <TextView
                        style="@style/LumoraSettingsRowSubtitle"
                        android:text="Invite others to create with Lumora" />
                </LinearLayout>

                <FrameLayout style="@style/LumoraSettingsArrowButton">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="15dp"
                        android:src="@drawable/ic_lumora_arrow_right"
                        android:tint="@color/lumora_lime" />
                </FrameLayout>
            </LinearLayout>

            <!-- ── Version ────────────────────────────────────────────── -->
            <TextView
                android:id="@+id/versionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#97A1B7"
                android:textSize="12sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
