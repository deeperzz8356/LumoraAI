<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginBottom="12dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:background="@drawable/bg_language_row" android:clickable="true" android:focusable="true" android:minHeight="48dp">
    <RadioButton android:id="@+id/radio" android:layout_width="48dp" android:layout_height="48dp"
        android:buttonTint="@color/lumora_secondary" android:clickable="false" android:focusable="false" />
    <TextView android:id="@+id/flag" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="24sp" />
    <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="14dp" android:textColor="@color/lumora_text_primary" android:textSize="17sp" />
</LinearLayout>
