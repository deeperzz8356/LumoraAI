<?xml version="1.0" encoding="utf-8"?>
<!--
  App-owned loading overlay shown briefly ONLY while an already-requested
  full-screen ad becomes ready (e.g. splash -> app open). This is our own UI and
  never imitates Google's ad creative. It is always dismissed by an explicit
  timeout so the user is never trapped.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fullscreen_loading_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#081020"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/fullscreen_loading_spinner"
            style="?android:attr/progressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#D6FF2F" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/app_name"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
