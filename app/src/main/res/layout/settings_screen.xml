<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/lumora_app_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"
        android:background="@drawable/bg_generation_bottom"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_common_icon_circle"
            android:clickable="true"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_lumora_back"
            android:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="Settings"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:includeFontPadding="false"
                android:text="Account, language, and plan controls"
                android:textColor="#FF95A0B7"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_common_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="Account"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/manageProfileRow"
            style="@style/LumoraSettingsRow"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_common_lime_circle_soft"
                android:padding="10dp"
                android:src="@drawable/ic_lumora_avatar"
                android:tint="@color/lumora_lime" />

            <LinearLayout style="@style/LumoraSettingsTextColumn">
                <TextView
                    style="@style/LumoraSettingsRowTitle"
                    android:text="Manage Profile" />
                <TextView
                    style="@style/LumoraSettingsRowSubtitle"
                    android:text="Update your name and account details" />
            </LinearLayout>

            <FrameLayout style="@style/LumoraSettingsArrowButton">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="15dp"
                    android:src="@drawable/ic_lumora_arrow_right"
                    android:tint="@color/lumora_lime" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/subscriptionRow"
            style="@style/LumoraSettingsRow">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_common_lime_circle_soft"
                android:padding="10dp"
                android:src="@drawable/ic_lumora_star"
                android:tint="@color/lumora_lime" />

            <LinearLayout style="@style/LumoraSettingsTextColumn">
                <TextView
                    style="@style/LumoraSettingsRowTitle"
                    android:text="Subscription &amp; Billing" />
                <TextView
                    style="@style/LumoraSettingsRowSubtitle"
                    android:text="Plans, purchases, and credit packs" />
            </LinearLayout>

            <FrameLayout style="@style/LumoraSettingsArrowButton">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="15dp"
                    android:src="@drawable/ic_lumora_arrow_right"
                    android:tint="@color/lumora_lime" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_common_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="Preferences"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/languageRow"
            style="@style/LumoraSettingsRow"
            android:layout_marginTop="12dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_common_lime_circle_soft"
                android:padding="10dp"
                android:src="@drawable/ic_lumora_settings"
                android:tint="@color/lumora_lime" />

            <LinearLayout style="@style/LumoraSettingsTextColumn">
                <TextView
                    style="@style/LumoraSettingsRowTitle"
                    android:text="Language" />
                <TextView
                    android:id="@+id/languageSubtitle"
                    style="@style/LumoraSettingsRowSubtitle"
                    android:text="English" />
            </LinearLayout>

            <FrameLayout style="@style/LumoraSettingsArrowButton">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="15dp"
                    android:src="@drawable/ic_lumora_arrow_right"
                    android:tint="@color/lumora_lime" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/versionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="#97A1B7"
        android:textSize="12sp" />
</LinearLayout>
