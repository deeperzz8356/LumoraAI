<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginBottom="12dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
    android:background="@drawable/bg_language_row" android:clickable="true" android:focusable="true" android:minHeight="48dp">
    <FrameLayout android:id="@+id/radio" android:layout_width="26dp" android:layout_height="26dp"
        android:background="@drawable/bg_language_radio">
        <View android:id="@+id/radioInner" android:layout_width="14dp" android:layout_height="14dp"
            android:layout_gravity="center" android:background="@drawable/bg_circle_white" android:visibility="gone" />
    </FrameLayout>
    <TextView android:id="@+id/flag" android:layout_width="32dp" android:layout_height="24dp"
        android:layout_marginStart="14dp" android:gravity="center" android:includeFontPadding="false" android:textSize="24sp" />
    <TextView android:id="@+id/name" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="18dp" android:textColor="@color/lumora_text_primary" android:textSize="17sp" />
</LinearLayout>
